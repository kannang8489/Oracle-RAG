# ============================================================
#  Oracle RAG — Environment Variables
#  Copy this file to .env and fill in your values.
#  The .env file is gitignored and never committed.
# ============================================================

# ── Oracle 23ai Autonomous Database (Cloud) ─────────────────
#
#  HOW TO GET THESE VALUES:
#  1. Log in to https://cloud.oracle.com
#  2. Navigate to: Oracle Database → Autonomous Database → your instance
#  3. Click "Database Connection" → Download Wallet
#     • Choose "Instance Wallet" and set a wallet password  ← remember this!
#     • Extract the ZIP to a local folder, e.g. C:\wallet\Wallet_mydb
#  4. Open tnsnames.ora inside the wallet folder.
#     Pick one alias (recommended: _medium for RAG workloads)
#  NOTE: DB_WALLET_DIR must point to the EXTRACTED folder, not the ZIP file.
#        Use forward slashes even on Windows: C:/wallet/Wallet_mydb
#
DB_TNS_ALIAS=mydb_medium
DB_WALLET_DIR=C:/wallet/Wallet_mydb
DB_23AI_USERNAME=ADMIN
DB_23AI_PASSWORD=YourADBPassword123!
DB_WALLET_PASSWORD=YourWalletDownloadPassword!

# ── Admin Panel Credentials ──────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ── LLM (Ollama — local) ─────────────────────────────────────
# Ollama must be running locally with the model pulled.
# Run: ollama pull llama3:latest
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3:latest

# ── GitHub Repository Agent ──────────────────────────────────
# GITHUB_TOKEN — Personal Access Token for private repos (leave blank for public)
# GITHUB_CLONE_DIR — where repos are cloned locally
GITHUB_TOKEN=
GITHUB_CLONE_DIR=C:/oracle-rag-repos
